# Copy to .env and fill in your own key. NEVER commit .env.
# Get a free key at https://console.groq.com/keys

GROQ_API_KEY=your_groq_api_key_here

# Optional. Default: llama-3.3-70b-versatile
# Alternatives: llama-3.1-8b-instant (cheaper/faster), openai/gpt-oss-120b
GROQ_MODEL=llama-3.3-70b-versatile

# Optional. Groq's OpenAI-compatible endpoint (change to swap providers).
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Set to 1 to run fully offline with deterministic canned replies.
# Tests run in this mode; the app falls back to it automatically with no key.
LLM_MOCK=0

# Sampling
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=400

# Demo switch: set to 1 to make every site-visit booking fail,
# so the failure path can be shown on demand.
BOOKING_FORCE_FAILURE=0
