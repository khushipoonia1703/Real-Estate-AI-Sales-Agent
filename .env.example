# =====================================================================
# Northstar Homes AI Sales Agent — environment variables
# Copy this file to ".env" and fill in your own key.
# NEVER commit your real .env (it is git-ignored).
# =====================================================================

# --- Required: your Groq API key --------------------------------------
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# --- Model (optional) -------------------------------------------------
# Default is openai/gpt-oss-safeguard-20b. Model access varies by key: the
# Llama models (llama-3.3-70b-versatile, llama-3.1-8b-instant) return
# "model_not_found" on some keys, and groq/compound* route to Llama
# internally so they fail the same way. Check yours with /openai/v1/models.
# Alternatives: openai/gpt-oss-120b , openai/gpt-oss-20b (own daily budgets).
# Avoid qwen/qwen3.6-27b here: it emits its reasoning in the reply body and
# spends the whole token budget thinking before it answers.
GROQ_MODEL=openai/gpt-oss-safeguard-20b

# --- Strict model (optional) ------------------------------------------
# Set to 1 to forbid fallbacks entirely: if GROQ_MODEL cannot serve a
# request the request fails, instead of being answered - and billed - by
# a different model. Every fallback is logged as a WARNING either way.
GROQ_STRICT_MODEL=0

# --- Groq endpoint (optional) -----------------------------------------
# Groq's OpenAI-compatible endpoint. Change only to swap providers.
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Offline / mock mode (optional) -----------------------------------
# Set to 1 to run with deterministic canned replies and no network calls.
# The automated tests run in this mode, and the app falls back to it
# automatically whenever no GROQ_API_KEY is set.
LLM_MOCK=0

# --- Sampling (optional) ----------------------------------------------
# LLM_MAX_TOKENS covers the model's internal reasoning as well as the visible
# reply. The GPT-OSS models spend most of it thinking, so 400 truncates
# answers mid-sentence; 900 leaves room. Raising it costs tokens per turn,
# which matters against Groq's per-day and per-minute caps.
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=900

# --- Demo switch (optional) -------------------------------------------
# Set to 1 to force every site-visit booking to fail, so the failure
# path can be demonstrated on demand.
BOOKING_FORCE_FAILURE=0

# --- Conversation storage (optional) ----------------------------------
# Where conversations are persisted as JSON. Defaults to data/conversations.json
CONVERSATIONS_PATH=data/conversations.json
